<% content_for :title, "会員登録 | Tasklet" %>

<div class="mt-12 w-full max-w-[420px] text-center">
  <p class="text-[11px] font-semibold tracking-[0.12em] text-brand-dot">CREATE ACCOUNT</p>
  <h1 class="mt-3 font-serif text-[32px] font-bold tracking-tight">はじめましょう</h1>
  <p class="mt-3 text-[13px] leading-relaxed text-muted">大きなタスクも、AI が実行できる手順に分解します。</p>
</div>

<%= form_with model: @user, url: registration_path,
              class: "mt-9 w-full max-w-[420px] space-y-5 rounded-2xl border border-line bg-white p-8 shadow-float" do |f| %>

  <%# エラーメッセージ表示ブロック（入力不備がある場合のみ赤枠で表示） %>
  <% if @user.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-left">
      <p class="text-[13px] font-semibold text-red-700">入力内容をご確認ください：</p>
      <ul class="mt-1.5 list-inside list-disc space-y-1 text-[12px] text-red-600">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# お名前 %>
  <div class="space-y-1.5 text-left">
    <%= f.label :name, "お名前", class: "block text-[11px] font-medium text-main" %>
    <%= f.text_field :name, placeholder: "山田 優", autocomplete: "name", required: true,
                     class: "w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14px] outline-none transition focus:border-brand focus:ring-1 focus:ring-brand" %>
  </div>

  <%# メールアドレス %>
  <div class="space-y-1.5 text-left">
    <%= f.label :email_address, "メールアドレス", class: "block text-[11px] font-medium text-main" %>
    <%= f.email_field :email_address, placeholder: "you@example.com", autocomplete: "email", required: true,
                      class: "w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14px] outline-none transition focus:border-brand focus:ring-1 focus:ring-brand" %>
  </div>

  <%# パスワード %>
  <div class="space-y-1.5 text-left">
    <%= f.label :password, "パスワード", class: "block text-[11px] font-medium text-main" %>
    <%= f.password_field :password, autocomplete: "new-password", minlength: 8, required: true,
                         class: "w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14px] outline-none transition focus:border-brand focus:ring-1 focus:ring-brand" %>
    <p class="text-2xs text-subtle">8文字以上で入力してください</p>
  </div>

  <%# パスワード（確認） %>
  <div class="space-y-1.5 text-left">
    <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-[11px] font-medium text-main" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                         class: "w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14px] outline-none transition focus:border-brand focus:ring-1 focus:ring-brand" %>
  </div>

  <%# 利用規約チェックボックス（別タブ維持） %>
  <div>
    <label class="flex items-start gap-2 text-[11px] text-muted">
      <%= f.check_box :terms_of_service, { required: true, class: "mt-0.5 h-3.5 w-3.5 rounded border-line accent-brand" }, "1", "0" %>
      <span><% legal_link = { target: "_blank", rel: "noopener", aria: { describedby: "terms-new-tab" }, class: "text-brand underline-offset-2 hover:underline" } %><%= link_to "利用規約", terms_mock_path, **legal_link %>と<%= link_to "プライバシーポリシー", privacy_mock_path, **legal_link %>に同意する</span>
    </label>
    <p id="terms-new-tab" class="mt-1 pl-[22px] text-2xs text-subtle">（いずれも新しいタブで開きます）</p>
  </div>

  <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand py-3.5 text-[13px] font-semibold text-white hover:bg-brand-hover">
    アカウントを作成する
    <%= render "shared/icon", name: :chevron_right, class: "h-3.5 w-3.5" %>
  </button>
<% end %>

<p class="mt-6 text-[12px] text-muted">
  すでにアカウントをお持ちの方は <%= link_to "ログイン", new_session_path, class: "font-semibold text-brand hover:underline" %>
</p>