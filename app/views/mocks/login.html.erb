<% content_for :title, "ログイン | Tasklet" %>

<div class="mt-12 w-full max-w-[420px] text-center">
  <p class="text-[11px] font-semibold tracking-[0.12em] text-brand-dot">WELCOME BACK</p>
  <h1 class="mt-3 font-serif text-[32px] font-bold tracking-tight">おかえりなさい</h1>
  <p class="mt-3 text-[13px] leading-relaxed text-muted">ログインして、今日のタスクを確認しましょう。</p>
</div>

<%= form_with url: login_mock_path, method: :post, data: { turbo: false },
              class: "mt-9 w-full max-w-[420px] space-y-5 rounded-2xl border border-line bg-white p-8 shadow-float" do %>
  <%= render "mocks/auth_field", id: "email", label: "メールアドレス", type: "email", placeholder: "you@example.com", autocomplete: "username" %>
  <%= render "mocks/auth_field", id: "password", label: "パスワード", type: "password", autocomplete: "current-password" %>

  <label class="flex items-center gap-2 text-[11px] text-muted">
    <input type="checkbox" name="remember_me" value="1" class="h-3.5 w-3.5 rounded border-line accent-brand">
    ログイン状態を保持する
  </label>

  <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand py-3.5 text-[13px] font-semibold text-white hover:bg-brand-hover">
    ログイン
    <%= render "shared/icon", name: :chevron_right, class: "h-3.5 w-3.5" %>
  </button>
<% end %>

<p class="mt-6 text-[12px] text-muted">
  アカウントをお持ちでない方は <%= link_to "会員登録", signup_mock_path, class: "font-semibold text-brand hover:underline" %>
</p>
