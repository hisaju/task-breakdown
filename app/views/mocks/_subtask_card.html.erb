<%#
  S-4 のサブタスクカード。locals: subtask:（kind / due / done / title / description）、number:（"01" などの表示番号。
  追加用テンプレートでは "__NUMBER__" を渡し、subtasks_controller が置き換える）
  完了状態は data-done だけで表し、チェックの塗り・打ち消し線は CSS（group-data-[done=true]）が描く
%>
<% kinds = {
     basic: { label: "基本タスク", title: "自分だけで進められる手順", class: "bg-brand-soft text-brand" },
     special: { label: "特殊タスク", title: "他者の確認・承認・返答待ちが発生する手順。早めに着手する", class: "bg-accent-soft text-accent" }
   } %>
<% kind = kinds.fetch(subtask[:kind]) %>
<li class="group flex gap-4 rounded-xl border border-line bg-white px-5 py-5 transition hover:shadow-card"
    data-done="<%= subtask[:done] %>" <%= "data-hidden-by-done" if subtask[:done] %> data-due-key="<%= due_key(subtask[:due]) %>"
    data-controller="subtask-card" data-subtask-card-title-value="<%= subtask[:title] %>">
  <button type="button" data-action="subtask-card#toggle" data-subtask-card-target="check"
          aria-label="「<%= subtask[:title] %>」を<%= subtask[:done] ? "未完了に戻す" : "完了にする" %>"
          class="mt-3 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-line-strong text-[11px] text-white hover:border-brand group-data-[done=true]:border-brand group-data-[done=true]:bg-brand">
    <span class="invisible group-data-[done=true]:visible" aria-hidden="true">✓</span>
  </button>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-3 text-2xs">
      <span class="<%= class_names("rounded px-1.5 py-1 font-semibold", kind[:class]) %>" title="<%= kind[:title] %>" data-kind-badge><%= kind[:label] %></span>
      <span class="flex items-center gap-1 text-muted">
        <%= render "shared/icon", name: :calendar, class: "h-3 w-3" %><%= due_time_tag(subtask[:due]) %>
      </span>
    </div>
    <p class="mt-2.5 text-[13px] font-semibold group-data-[done=true]:text-muted group-data-[done=true]:line-through" data-subtask-card-target="title"><%= subtask[:title] %></p>
    <p class="mt-2 text-2xs text-muted"><%= subtask[:description] %></p>
  </div>
  <div class="flex items-start gap-3 pt-1">
    <span class="pt-1.5 font-serif text-[11px] text-subtle" data-subtask-number><%= number %></span>
    <%= render "shared/menu", id: "subtask-menu-#{number}", label: "「#{subtask[:title]}」のメニュー",
                              items: [ { label: "編集" }, { label: "期限設定" }, { label: "削除", danger: true } ] %>
  </div>
</li>
