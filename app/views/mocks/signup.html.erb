<% content_for :title, "会員登録 | Tasklet" %>

<div class="mt-12 w-full max-w-[420px] text-center">
  <p class="text-[11px] font-semibold tracking-[0.12em] text-brand-dot">CREATE ACCOUNT</p>
  <h1 class="mt-3 font-serif text-[32px] font-bold tracking-tight">はじめましょう</h1>
  <p class="mt-3 text-[13px] leading-relaxed text-muted">大きなタスクも、AI が実行できる手順に分解します。</p>
</div>

<%= form_with url: signup_mock_path, method: :post, data: { turbo: false },
              class: "mt-9 w-full max-w-[420px] space-y-5 rounded-2xl border border-line bg-white p-8 shadow-float" do %>
  <%= render "mocks/auth_field", id: "name", label: "お名前", type: "text", placeholder: "山田 優", autocomplete: "name" %>
  <%= render "mocks/auth_field", id: "email", label: "メールアドレス", type: "email", placeholder: "you@example.com", autocomplete: "email" %>
  <%= render "mocks/auth_field", id: "password", label: "パスワード", type: "password", autocomplete: "new-password", minlength: 8, hint: "8文字以上で入力してください" %>
  <%= render "mocks/auth_field", id: "password_confirmation", label: "パスワード（確認）", type: "password", autocomplete: "new-password" %>

  <%# 規約は新しいタブで開き、入力途中のフォームを残す。新しいタブで開くことは同意文の下に表示し、各リンクの説明にもする %>
  <div>
    <label class="flex items-start gap-2 text-[11px] text-muted">
      <input type="checkbox" name="terms" value="1" required class="mt-0.5 h-3.5 w-3.5 rounded border-line accent-brand">
      <span><% legal_link = { target: "_blank", rel: "noopener", aria: { describedby: "terms-new-tab" }, class: "text-brand underline-offset-2 hover:underline" } %><%= link_to "利用規約", terms_mock_path, **legal_link %>と<%= link_to "プライバシーポリシー", privacy_mock_path, **legal_link %>に同意する</span>
    </label>
    <p id="terms-new-tab" class="mt-1 pl-[22px] text-2xs text-subtle">（いずれも新しいタブで開きます）</p>
  </div>

  <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-brand py-3.5 text-[13px] font-semibold text-white hover:bg-brand-hover">
    アカウントを作成する
    <%= render "shared/icon", name: :chevron_right, class: "h-3.5 w-3.5" %>
  </button>
<% end %>

<p class="mt-6 text-[12px] text-muted">
  すでにアカウントをお持ちの方は <%= link_to "ログイン", login_mock_path, class: "font-semibold text-brand hover:underline" %>
</p>
