<% content_for :title, "マイタスク | Tasklet" %>

<div class="flex min-h-screen flex-col" data-controller="completed-filter">
  <%= render "mocks/content_header" do %>
    <p class="text-[13px] font-semibold">マイタスク</p>
  <% end %>

  <div class="mx-auto w-full max-w-[850px] px-4 pb-16 pt-[64px]">
    <p class="text-[11px] font-semibold tracking-[0.12em] text-brand-dot">MY TASKS</p>
    <h1 class="mt-3 font-serif text-[40px] font-bold leading-[1.45] tracking-tight">マイタスク</h1>
    <p class="mt-4 text-[11px] text-muted">期限の近い順に並んでいます。タスクを選ぶと、分解した手順を確認できます。</p>

    <% if @parent_tasks.empty? %>
      <div class="mt-10" data-my-tasks-empty>
        <%= render "shared/empty_state", icon: :sparkles, title: "まだタスクがありません",
                                         body: "やりたいことを入力すると、AI が手順に分解します。",
                                         action: { label: "タスクを作る", href: root_path } %>
      </div>
    <% else %>
      <% done_of = ->(task) { task[:total].positive? && task[:done] == task[:total] } %>
      <%# 行番号は一覧全体の通し番号（メニューの id に使う） %>
      <% @parent_tasks.each.with_index(1).group_by { |task, _| due_key(task[:due]) }.each_value do |group| %>
        <%# 日付グループの中がすべて全完了なら、見出しごと隠す（completed_filter が group ターゲットとして追随する） %>
        <%= tag.section class: "mt-10", data: { completed_filter_target: "group", hidden_by_done: (true if group.all? { done_of.(it.first) }) } do %>
          <h2 class="mb-3 flex items-center gap-2 text-[11px] font-semibold text-muted">
            <% if group.first.first[:due] %>
              <%= render "shared/icon", name: :calendar, class: "h-3.5 w-3.5" %>
            <% end %>
            <%= due_label(group.first.first[:due], date_only: true) %>
          </h2>
          <ul class="space-y-2.5">
            <% group.each do |task, number| %>
              <% done = done_of.(task) %>
              <%# リンク（タイトル・期限・ステータス・進捗）とメニューは兄弟要素にする（リンクの中にボタンを入れない） %>
              <%# リンクの ::after をカード全面に広げ、余白を押しても S-4 へ移る（stretched link）。
                  メニューは DOM 上でリンクより後ろの positioned 要素なので、::after より前面に出る %>
              <li class="relative flex items-center gap-4 rounded-xl border border-line bg-white px-5 py-5 transition hover:shadow-card"
                  data-done="<%= done %>" <%= "data-hidden-by-done" if done %> data-due-key="<%= due_key(task[:due]) %>">
                <%# 期限も引き継ぐ（S-3 の datetime-local と同じ書式。期限なしは空の due で、S-4 は「期限なし」を表示する） %>
                <%= link_to task_detail_mock_path(title: task[:title], status: task[:status], due: task[:due]&.strftime("%Y-%m-%dT%H:%M") || ""),
                            class: "group flex min-w-0 flex-1 items-center gap-6 rounded-lg after:absolute after:inset-0 after:rounded-xl after:content-['']" do %>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3">
                      <%= render "shared/decomposition_status", status: task[:status] %>
                      <span class="flex items-center gap-1 text-2xs text-muted" data-row-due>
                        <%= render "shared/icon", name: :calendar, class: "h-3 w-3" %><%= due_time_tag(task[:due]) %>
                      </span>
                    </div>
                    <p class="<%= class_names("mt-2.5 font-serif text-[17px] font-bold group-hover:text-brand", "text-muted line-through": done) %>"><%= task[:title] %></p>
                  </div>

                  <div class="w-40 shrink-0 text-right">
                    <%= render "shared/task_progress", done: task[:done], total: task[:total] %>
                  </div>

                  <%= render "shared/icon", name: :chevron_right, class: "h-4 w-4 shrink-0 text-subtle group-hover:text-brand" %>
                <% end %>
                <%= render "shared/menu", id: "parent-task-menu-#{format('%02d', number)}", label: "「#{task[:title]}」のメニュー",
                                          items: [ { label: "編集" }, { label: "削除", danger: true } ] %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%# すべての親タスクが完了済みとして隠れたときだけ出す（completed_filter が hidden を切り替える） %>
      <%= tag.div class: "mt-10", data: { completed_filter_target: "empty" }, hidden: !@parent_tasks.all? { done_of.(it) } do %>
        <%= render "shared/empty_state", icon: :inbox, title: "表示できるタスクはありません",
                                         body: "完了したタスクは「完了済みを表示」で確認できます。" %>
      <% end %>
    <% end %>
  </div>
</div>
