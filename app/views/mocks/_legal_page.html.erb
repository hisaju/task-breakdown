<%# S-6 利用規約・S-7 プライバシーポリシー（ログイン前の画面）。title: eyebrow: paragraphs: は必須。
    本文は画面モック用のダミー。会員登録（S-2）の同意文から新しいタブで開く %>
<% content_for :title, "#{title} | Tasklet" %>

<div class="mt-12 w-full max-w-[640px] text-center">
  <p class="text-[11px] font-semibold tracking-[0.12em] text-brand-dot"><%= eyebrow %></p>
  <h1 class="mt-3 font-serif text-[32px] font-bold tracking-tight"><%= title %></h1>
  <p class="mt-3 text-[13px] leading-relaxed text-muted">本文はサンプルです。正式な文面は公開前に差し替えます。</p>
</div>

<article class="mt-9 w-full max-w-[640px] space-y-4 rounded-2xl border border-line bg-white p-8 text-[13px] leading-relaxed text-ink/80 shadow-float">
  <% paragraphs.each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>
</article>

<p class="mt-6 text-[12px] text-muted">
  <%= link_to signup_mock_path, class: "inline-flex items-center gap-1 font-semibold text-brand hover:underline" do %>
    <%= render "shared/icon", name: :chevron_left, class: "h-3.5 w-3.5" %>会員登録に戻る
  <% end %>
</p>
