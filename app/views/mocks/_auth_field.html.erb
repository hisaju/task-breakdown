<%# S-1・S-2 の入力欄。id: label: type: 必須。placeholder: autocomplete: hint: minlength: は任意。
    ログイン前の画面の入力はすべて必須なので required は既定で付ける（required: false で外す） %>
<% hint_id = "#{id}-hint" if local_assigns[:hint] %>
<div>
  <label for="<%= id %>" class="block text-[11px] font-semibold text-ink/80"><%= label %></label>
  <%= tag.input id:, name: id, type:, placeholder: local_assigns[:placeholder], autocomplete: local_assigns[:autocomplete],
                required: local_assigns.fetch(:required, true), minlength: local_assigns[:minlength],
                aria: { describedby: hint_id },
                class: "mt-2 block w-full rounded-lg border border-line bg-white px-3.5 py-3 text-sm placeholder:text-subtle focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-soft" %>
  <% if hint_id %>
    <p id="<%= hint_id %>" class="mt-1.5 text-2xs text-subtle"><%= hint %></p>
  <% end %>
</div>
