<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Tasklet" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tasklet">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas font-sans text-ink antialiased">
    <main class="flex min-h-screen flex-col items-center px-4 py-16">
      <%= link_to root_path, class: "flex items-center gap-2.5" do %>
        <span class="grid h-[34px] w-[34px] place-items-center rounded-lg bg-brand text-white">
          <%= render "shared/icon", name: :sparkles, class: "h-[18px] w-[18px]" %>
        </span>
        <span class="text-xl font-bold tracking-tight">Tasklet</span>
      <% end %>
      <%= yield %>
      <p class="mt-auto pt-12 text-[10px] text-subtle">© Tasklet</p>
    </main>
  </body>
</html>
