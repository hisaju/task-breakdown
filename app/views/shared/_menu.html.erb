<%#
  メニュー「…」。locals:
    id:        メニュー本体の id（トリガーの aria-controls と対応。画面内で一意にする）
    items:     [{ label:, href: nil, method: nil, danger: false }]
               - href があればリンク、無ければ見た目のみのボタン（data-mock="noop"。押すとメニューを閉じる）
               - method（例: :delete）を指定すると Turbo Method 経由でリクエストを送信可能
    placement: :down（既定。トリガーの下に開く）| :up（上に開く。画面下部に置くとき）
    label:     トリガーの aria-label（既定「メニュー」）。一覧で繰り返すときは対象名を入れる（例:「『〜』のメニュー」）
%>
<% placement = local_assigns.fetch(:placement, :down).to_sym %>
<div class="relative" data-controller="menu"
     data-action="click@window->menu#closeOnOutside keydown.esc->menu#closeAndFocus focusout->menu#closeOnFocusOut">
  <button type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="<%= id %>"
          aria-label="<%= local_assigns.fetch(:label, "メニュー") %>"
          class="grid h-7 w-7 place-items-center rounded-md text-subtle hover:bg-canvas hover:text-ink"
          data-menu-target="trigger" data-action="menu#toggle">
    <%= render "shared/icon", name: :more, class: "h-4 w-4" %>
  </button>
  <div id="<%= id %>" role="menu" hidden data-menu-target="menu" data-action="keydown->menu#navigate"
       class="<%= class_names("absolute right-0 z-30 w-40 rounded-lg border border-line bg-white py-1 shadow-card",
                              placement == :up ? "bottom-full mb-2" : "top-full mt-1") %>">
    <% items.each do |item| %>
      <% item_class = class_names("block w-full px-3 py-2 text-left text-[11px] font-semibold hover:bg-canvas",
                                  item[:danger] ? "text-danger" : "text-ink") %>
      <% if item[:href] %>
        <%# method（:delete 等）が指定されている場合は Turbo Method で送信（ログアウトや削除処理用） %>
        <%= link_to item[:label], item[:href], role: "menuitem", tabindex: -1,
                    data: (item[:data] || {}).merge(item[:method] ? { turbo_method: item[:method] } : {}),
                    class: item_class %>
      <% else %>
        <button type="button" role="menuitem" tabindex="-1" data-mock="noop" data-action="menu#closeAndFocus" class="<%= item_class %>"><%= item[:label] %></button>
      <% end %>
    <% end %>
  </div>
</div>