<%# 親タスクの進捗。「n/m 完了」とプログレスバー。サブタスクが無い（total 0）ときは「—」 %>
<div data-task-progress>
  <% if total.positive? %>
    <p class="text-2xs text-muted"><%= done %>/<%= total %> 完了</p>
    <div class="mt-2 h-1.5 rounded-full bg-brand-soft" aria-hidden="true">
      <div class="h-1.5 rounded-full bg-brand" style="width: <%= done * 100 / total %>%"></div>
    </div>
  <% else %>
    <p class="text-2xs text-subtle">—</p>
  <% end %>
</div>
