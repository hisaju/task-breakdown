<%#
  空状態。locals:
    icon:   shared/icon の name
    title:  見出し
    body:   補足（任意）
    action: { label:, href: }（任意）
    data:   ルート要素の data 属性（任意。例: { completed_filter_target: "empty" }）
    hidden: true なら初期非表示（任意。完了フィルタが表示を切り替える場合に使う）
%>
<%= tag.div class: "flex flex-col items-center rounded-xl border border-line bg-white px-6 py-14 text-center",
            data: local_assigns[:data], hidden: local_assigns[:hidden] || nil do %>
  <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-soft text-brand">
    <%= render "shared/icon", name: icon, class: "h-5 w-5" %>
  </span>
  <h2 class="mt-4 text-[13px] font-semibold"><%= title %></h2>
  <% if local_assigns[:body] %>
    <p class="mt-2 text-[11px] text-muted"><%= body %></p>
  <% end %>
  <% if local_assigns[:action] %>
    <%= link_to action[:label], action[:href],
                class: "mt-6 rounded-lg bg-brand px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-brand-hover" %>
  <% end %>
<% end %>
